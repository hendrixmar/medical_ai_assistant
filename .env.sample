APP_ENV=development
PORT=8080
# Keep the backend private behind an HTTPS proxy for browser use.
BIND_ADDRESS=127.0.0.1

# Required: supply your own connection string for a separate, fresh database.
# Existing databases with the removed boilerplate migration are unsupported.
DATABASE_URL=
DATABASE_POOL_MAX_SIZE=50
DATABASE_TIMEOUT=5
DATABASE_RUN_MIGRATIONS=true

# Swagger and OpenAPI are available only in development.
SWAGGER_ENDPOINT=/docs

# Doctor authentication: missing values disable login, not health.
# Exact canonical browser HTTPS origin, with no trailing slash/path/query.
PUBLIC_ORIGIN=
# Operator-supplied stable base64-encoded 32-byte key; never commit a real key.
# Also derives separate Doctor Number encryption keys. Preserve this key
# and issued fingerprint history; offline maintenance rotation
# (db rotate-doctor-key, NEW_DOCTOR_TOTP_KEY only for the CLI) preserves
# fingerprint non-reuse and must not permit code-value reuse. No new
# production key variable is added for rotation.
BCRYPT_COST=12

# Optional WAHA integration: leave ALL THREE absent until securely provisioned.
# All supplied values must be valid; partial or empty supplied values fail startup.
# Canonical origin: HTTPS, except explicit loopback HTTP for internal service access.
# WAHA_BASE_URL=
# Plain server-only API credential, never the provider's stored SHA-512 hash.
# WAHA_API_KEY=
# Operator-generated random secret >=32 characters; literal UTF-8, not base64-decoded.
# Must match the operator-owned webhook config; application does not register it.
# WAHA_WEBHOOK_HMAC_KEY=
# Independent opt-in: false makes ZERO ID/seen/typing/send calls; intake/queues/acks continue.
# true requires all WAHA settings plus canonical HTTPS PUBLIC_ORIGIN. Restart all workers
# consistently; disabling does not cancel already-running provider work or grant legal approval.
WAHA_OUTBOUND_ENABLED=false
# Application policy, NOT a provider-approved safe threshold. Positive integer 1..1000.
# Counts all irreversible commitments per Contact per rolling hour, including resolution notices.
WAHA_CONTACT_REPLIES_PER_HOUR=20
# Phone-event attribution must be independently accepted for the pinned GOWS version.
# Keep disabled until authorized #2299/current-peer evidence is verified; not an outbound opt-in.
WAHA_TAKEOVER_ENABLED=false

# Optional Google Calendar: leave ALL THREE absent until securely provisioned.
# Partial/empty/malformed inputs fail startup; requires canonical HTTPS PUBLIC_ORIGIN.
# Web application client; exact callback PUBLIC_ORIGIN + /settings/google/callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Standard base64, exactly 32 bytes, stable across restarts; separate from DOCTOR_TOTP_KEY.
# Logical key ID: GOOGLE_TOKEN_KEY / Google AEAD v1. No auto-generation or default.
# Offline maintenance only: db rotate-google-key (or --reconnect-only after a
# lost key) with NEW_GOOGLE_TOKEN_KEY supplied only to the CLI; see README.

# Optional Claude date/intent parsing: leave BOTH absent until securely provisioned.
# There is no default model. Numeric menu booking and simple Doctor agenda queries work without it.
# CLAUDE_API_KEY=
# CLAUDE_MODEL=

# Application logging is fixed to off,server=info. RUST_LOG cannot widen it:
# HTTP dependencies, raw callback URI/query, headers and credentials must not be logged.
# Configure private proxy access logs separately to suppress the callback query.
